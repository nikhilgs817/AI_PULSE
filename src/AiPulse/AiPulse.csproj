    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13"/><PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6"/>
    <PackageReference Include="System.Management" Version="10.0.13"/><PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.13"/>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13"/>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>
</Project>
