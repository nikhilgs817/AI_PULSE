<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework><AssemblyName>AiPulse</AssemblyName>
    <RootNamespace>AiPulse</RootNamespace><Version>0.3.5</Version><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets/pulse.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport><PublishTrimmed>false</PublishTrimmed>
    <Product>AIPULSE</Product><Company>AI Pulse contributors</Company>
    <Copyright>Copyright (c) 2026 AI Pulse contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**"/>
    <PackageReference Include="Avalonia" Version="12.1.4"/><PackageReference Include="Avalonia.Desktop" Version="12.1.4"/><PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4"/>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13"/><PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6"/>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3"/>
    <PackageReference Include="Google.Protobuf" Version="3.36.2"/>
    <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="All"/>
    <PackageReference Include="System.Management" Version="10.0.13"/><PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.13"/>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13"/>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>
  <ItemGroup><Protobuf Include="Telemetry/Proto/**/*.proto" ProtoRoot="Telemetry/Proto" GrpcServices="None" /></ItemGroup>
</Project>
